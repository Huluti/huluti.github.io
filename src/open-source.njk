---
layout: base.njk
title: Open Source Work
---

<section id="content-header" class="section section-bg">
    <h2>Open Source Work</h2>
</section>

<section id="contributions" class="section">
    {% for topic in contributions.topics %}
        <section id="{{ topic.name| slug }}" class="mb-40">
            <h2>{{ topic.name }}</h2>
            {% for project in topic.projects %}
                <div class="mb-40">
                    <h3>{{ project.name }}</h3>
                    {% for item in project.items %}
                        <p class="mb-20">
                            <span class="badge badge-{{ item.type }}">
                                {{ "Issue" if item.type == "issue" else "MR" }}
                            </span>
                            <span class="repo-name">{{ item.repo }}</span>
                            <a href="{{ item.url }}">{{ item.title }}</a>
                            {% if item.fixes_url %}
                                → fixes <a class="related-link" href="{{ item.fixes_url }}">{{ item.fixes_label }}</a>
                            {% elif item.fixed_by_url %}
                                → fixed by <a class="related-link" href="{{ item.fixed_by_url }}">{{ item.fixed_by_label }}</a>
                            {% endif %}
                        </p>
                    {% endfor %}
                </div>
            {% endfor %}
        </section>
    {% endfor %}
</section>
